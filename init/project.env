# .claude/project.env — 이 저장소만의 값 (오버레이 — claude-ops 가 덮지 않는다).
#
# preflight · postflight 가 source 하므로 유효한 셸 변수 문법이어야 한다.
# 값을 정한 **근거**는 짧게 여기 적거나 길면 docs/ 로 — 에이전트는 이 파일을 읽지 않고 preflight 출력만 본다.

# 작업 브랜치가 여기서 갈라져 나왔는지 검사한다. GitHub 저장소의 기본 브랜치를 실제로 확인해 적는다.
DEFAULT_BRANCH=main

# 공동 작성자 트레일러의 **기본값** — 오케스트레이터가 CLAUDE_COAUTHOR 를 넘기지 않았을 때만 쓴다.
# 평소 오케스트레이터의 모델을 적는다(모델은 작업마다 고른다 — 오케스트레이터 규약 12).
COMMIT_TRAILER_COAUTHOR="Co-Authored-By: Claude Opus <noreply@anthropic.com>"

# 공동 작성자 줄의 **모양** 재정의(새 모델 계열이 생겨 기본값이 모를 때만). 이 파일에서만 받는다.
# COMMIT_TRAILER_COAUTHOR_RE='^Co-Authored-By: Claude (Opus|Sonnet|Haiku|Fable)( [1-9][0-9]*(\.[0-9]+)?)? <noreply@anthropic\.com>$'

# 에이전트가 끝내기 전에 통과해야 하는 명령 — **실제로 돌려 보고** 정한다.
# 항상 실패하는 명령(예: 실제 키가 없으면 멈추는 빌드)을 넣으면 모든 에이전트가 거기서 막힌다(규약 L2-4).
# 전체 스위트는 CI 에서 한 번, 에이전트는 바뀐 범위만 돌리는 명령을 권한다.
VERIFY_CMD="npm test"

# 에이전트 보고서가 놓이는 곳. 오케스트레이터는 완료 알림이 아니라 이 디렉터리의 파일을 읽는다.
REPORT_DIR=".claude/reports"

# 보고서 맨 앞 「## 요약」 의 최대 줄 수(기본 20). 이 파일에서만 바꿀 수 있다.
# REPORT_SUMMARY_MAX_LINES=20

# 에이전트가 수정·삭제하면 안 되는 경로 (공백 구분). 새 파일 추가는 막지 않는다.
# 「고치지 마라」 가 아니라 「고칠 때 사용처를 다 확인해라」 가 맞는 파일은 넣지 않는다(규약 L2-5).
PROTECTED_PATHS=""

# 이 환경의 제약 — preflight 가 출력해 에이전트가 헛수고하지 않게 한다(실제로 돌려 확인한 것만).
ENV_NOTES=""
